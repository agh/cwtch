#!/bin/bash
# cwtch - Manage Claude Code profiles and configuration.
# shellcheck disable=SC2154
set -euo pipefail

SCRIPT_PATH="$0"
while [[ -L "${SCRIPT_PATH}" ]]; do
  DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
  SCRIPT_PATH="$(readlink "${SCRIPT_PATH}")"
  [[ "${SCRIPT_PATH}" != /* ]] && SCRIPT_PATH="${DIR}/${SCRIPT_PATH}"
done
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
# shellcheck source=../lib/common.sh
source "${SCRIPT_DIR}/../lib/common.sh"
# shellcheck source=../lib/config.sh
source "${SCRIPT_DIR}/../lib/config.sh"
# shellcheck source=../lib/sync.sh
source "${SCRIPT_DIR}/../lib/sync.sh"

get_version() {
  local version_file="${SCRIPT_DIR}/../VERSION"
  if [[ -f "${version_file}" ]]; then
    tr -d '\n' <"${version_file}"
  else
    printf 'dev'
  fi
}

# Follow the releases/latest redirect: no API token, no rate limit.
check_latest_version() {
  local location
  location="$(curl -sIL --max-time 3 "https://github.com/agh/cwtch/releases/latest" 2>/dev/null |
    tr -d '\r' | grep -i '^location:' | tail -1)" || return 1
  [[ -n "${location}" ]] || return 1
  printf '%s\n' "${location}" | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | tail -1 | sed 's/^v//'
}

version_gt() {
  # Returns 0 if $1 > $2 using semantic versioning
  [[ "$1" != "$2" ]] && [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" == "$1" ]]
}

cmd_version_short() {
  printf 'cwtch %s\n' "$(get_version)"
}

cmd_version() {
  local version latest
  version="$(get_version)"
  printf 'cwtch %s\n' "${version}"
  latest="$(check_latest_version)" || latest=""
  if [[ -z "${latest}" ]]; then
    dim "Could not check for updates"
  elif version_gt "${latest}" "${version}"; then
    printf '%b\n' "${C_YELLOW}${SYM_ARROW}${C_RESET} New version available: ${C_GREEN}v${latest}${C_RESET} (brew upgrade cwtch)"
  else
    log "You're running the latest version"
  fi
  return 0
}

help_row() { printf '%-28s %s\n' "  $1" "$2"; }

usage_help() {
  printf '%b\n' "${C_BOLD}cwtch${C_RESET} ${C_DIM}v$(get_version) — profiles & config for Claude Code${C_RESET}"
  printf '\n%b\n' "${C_BOLD}USAGE${C_RESET}"
  printf '%s\n' "  cwtch <command> [args]"
  printf '\n%b\n' "${C_BOLD}COMMANDS${C_RESET}"
  help_row "status" "Show the active profile and sync state"
  help_row "usage" "Show usage for OAuth profiles"
  printf '\n'
  help_row "sync" "Pull sources and build ~/.claude/"
  help_row "sync init" "Create an example Cwtchfile"
  help_row "sync check" "Validate the Cwtchfile"
  printf '\n'
  help_row "profile list" "List saved profiles"
  help_row "profile current" "Print the active profile's name"
  help_row "profile setup <name>" "Create and save a long-lived token (easiest)"
  help_row "profile save-token <name>" "Save an existing long-lived token"
  help_row "profile save-key <name>" "Save an API key profile"
  help_row "profile save <name>" "Save the Keychain OAuth login as a profile"
  help_row "profile use <name>" "Switch to a profile"
  help_row "profile delete <name>" "Delete a profile"
  help_row "profile env" "Print shell exports for the active profile"
  help_row "profile token" "Print the active profile's token"
  help_row "profile api-key" "Print the active profile's API key"
  printf '\n'
  help_row "edit" "Edit the Cwtchfile"
  help_row "version" "Print the version and check for updates"
  help_row "-v, --version" "Print the version (offline)"
  help_row "-h, --help" "Show this help"
  printf '\n'
  printf '%s\n' "  Deprecated: refresh (does nothing; Claude Code refreshes its own login)"
  printf '\n'
}

cmd_sync() {
  local sub="" flags=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force | --dry-run) flags+=("$1") ;;
      -*)
        err "Unknown sync option: $1"
        exit 1
        ;;
      *)
        if [[ -n "${sub}" ]]; then
          err "Unknown sync command: $1"
          exit 1
        fi
        sub="$1"
        ;;
    esac
    shift
  done
  case "${sub}" in
    "") do_sync ${flags[@]+"${flags[@]}"} ;;
    init) sync_init ;;
    check) config_check ;;
    *)
      err "Unknown sync command: ${sub}"
      exit 1
      ;;
  esac
}

cmd_profile() {
  [[ $# -lt 1 ]] && {
    err "Missing profile subcommand"
    usage_help
    exit 1
  }
  local sub="$1"
  shift
  case "${sub}" in
    list) profile_list ;;
    current) current_profile || printf '%s\n' "(none)" ;;
    setup)
      [[ $# -lt 1 ]] && {
        err "Missing name"
        exit 1
      }
      cmd_setup "$1"
      ;;
    save)
      [[ $# -lt 1 ]] && {
        err "Missing name"
        exit 1
      }
      profile_save "$1"
      ;;
    save-key)
      [[ $# -lt 1 ]] && {
        err "Missing name"
        exit 1
      }
      cmd_save_key "$1"
      ;;
    save-token)
      [[ $# -lt 1 ]] && {
        err "Missing name"
        exit 1
      }
      cmd_save_token "$1"
      ;;
    use)
      [[ $# -lt 1 ]] && {
        err "Missing name"
        exit 1
      }
      profile_use "$1"
      ;;
    delete)
      [[ $# -lt 1 ]] && {
        err "Missing name"
        exit 1
      }
      profile_delete "$1"
      ;;
    api-key) cmd_apikey ;;
    token) cmd_token ;;
    env) cmd_env ;;
    *)
      err "Unknown profile command: ${sub}"
      exit 1
      ;;
  esac
}

read_secret() {
  local prompt="$1" value=""
  if [[ -t 0 ]]; then
    read -rsp "${prompt}" value || true
    printf '\n' >&2
  else
    read -r value || true
  fi
  printf '%s' "${value}"
}

cmd_save_key() {
  local name="$1" key
  validate_name "${name}" || exit 1
  key="$(read_secret "API key: ")"
  [[ -z "${key}" ]] && {
    err "No API key provided"
    exit 1
  }
  profile_save_key "${name}" "${key}"
}

cmd_save_token() {
  local name="$1" token
  validate_name "${name}" || exit 1
  token="$(read_secret "Token: ")"
  [[ -z "${token}" ]] && {
    err "No token provided"
    exit 1
  }
  profile_save_token "${name}" "${token}"
}

CWTCH_TMPFILE=""
cleanup_tmpfile() {
  [[ -n "${CWTCH_TMPFILE}" ]] && rm -f "${CWTCH_TMPFILE}"
  return 0
}

extract_tokens() { printf '%s' "$1" | grep -oE 'sk-ant-oat01-[A-Za-z0-9_-]+' | sort -u || true; }

cmd_setup() {
  local name="$1" stripped tokens count token
  validate_name "${name}" || exit 1
  CWTCH_TMPFILE="$(mktemp "${TMPDIR:-/tmp}/cwtch-setup.XXXXXX")" || {
    err "Could not create a temporary file"
    return 1
  }
  trap cleanup_tmpfile EXIT
  info "Running claude setup-token..."
  claude setup-token >"${CWTCH_TMPFILE}" 2>&1 || {
    err "Failed to run claude setup-token"
    return 1
  }
  stripped="$(sed $'s/\x1b\[[0-9;]*[A-Za-z]//g' "${CWTCH_TMPFILE}")"
  cleanup_tmpfile
  CWTCH_TMPFILE=""
  trap - EXIT
  tokens="$(extract_tokens "${stripped}")"
  count="$(printf '%s\n' "${tokens}" | grep -c . || true)"
  if [[ "${count}" -lt 2 ]] && ! [[ "${tokens}" =~ ${TOKEN_RE} ]]; then
    # No whole token on one line: recover one that the terminal wrapped.
    tokens="$(extract_tokens "$(printf '%s' "${stripped}" | tr -d '\n\r ')")"
    count="$(printf '%s\n' "${tokens}" | grep -c . || true)"
  fi
  [[ "${count}" -eq 0 ]] && {
    err "Could not find a token in claude setup-token output"
    return 1
  }
  [[ "${count}" -gt 1 ]] && {
    err "Found ${count} candidate tokens; use 'cwtch profile save-token ${name}' and paste the token"
    return 1
  }
  token="$(printf '%s\n' "${tokens}" | head -1)"
  profile_save_token "${name}" "${token}" || return 1
  printf '  Apply to this shell: %b\n' "${C_CYAN}eval \"\$(cwtch profile env)\"${C_RESET}"
}

cmd_apikey() {
  local key
  key="$(get_current_apikey)" || {
    err "Current profile is not an API key profile"
    exit 1
  }
  printf '%s\n' "${key}"
}

cmd_token() {
  local token
  token="$(get_current_token)" || {
    err "Current profile is not a token profile"
    exit 1
  }
  printf '%s\n' "${token}"
}

env_precedence_warnings() {
  local var value
  for var in ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY; do
    value="$(printenv "${var}")" || value=""
    [[ -n "${value}" ]] && printf '# %s is set in this shell and takes precedence over this profile\n' "${var}"
  done
  return 0
}

cmd_env() {
  local name type value
  name="$(current_profile)" || {
    err "No profile active"
    exit 1
  }
  type="$(profile_type "${name}")"
  case "${type}" in
    token)
      value="$(cat "${PROFILES_DIR}/${name}/.token")"
      [[ "${value}" =~ ${TOKEN_RE} ]] || {
        err "Stored token for '${name}' has an unexpected format; refusing to print"
        exit 1
      }
      printf '%s\n' "unset CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY"
      printf "export CLAUDE_CODE_OAUTH_TOKEN='%s'\n" "${value}"
      ;;
    api-key)
      value="$(cat "${PROFILES_DIR}/${name}/.apikey")"
      [[ "${value}" =~ ${APIKEY_RE} ]] || {
        err "Stored API key for '${name}' has an unexpected format; refusing to print"
        exit 1
      }
      printf '%s\n' "unset CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY"
      printf "export ANTHROPIC_API_KEY='%s'\n" "${value}"
      ;;
    oauth)
      printf '%s\n' "unset CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY"
      printf "# OAuth profile '%s': Claude Code uses the Keychain login\n" "${name}"
      ;;
    'mixed!')
      err "Profile '${name}' holds more than one credential; save it again to fix it"
      exit 1
      ;;
    *)
      err "No credential for '${name}'"
      exit 1
      ;;
  esac
  env_precedence_warnings
}

cmd_refresh() {
  local arg
  for arg in "$@"; do
    case "${arg}" in
      -q | --quiet) return 0 ;;
      *) ;;
    esac
  done
  printf '%s\n' "cwtch refresh is deprecated and does nothing: Claude Code refreshes its own login. If a login has expired, run /login inside Claude Code." >&2
  return 0
}

pct_of() {
  local raw="$1"
  [[ "${raw}" =~ ^[0-9]+$ ]] || raw=0
  printf '%s' "${raw}"
}

pct_colour() {
  local pct="$1"
  if [[ "${pct}" -ge 80 ]]; then
    printf '%s' "${C_RED}"
  elif [[ "${pct}" -ge 50 ]]; then
    printf '%s' "${C_YELLOW}"
  else printf '%s' "${C_GREEN}"; fi
}

profile_line() { printf '  %b%s%b\n' "$1${C_BOLD}" "$2" "${C_RESET}$3"; }

usage_oauth() {
  local dir="$1" name="$2" marker="$3" suffix="$4"
  local token data u5 u7 c5 c7 limits line
  token="$(get_token "${dir}.credential")" || token=""
  if [[ -z "${token}" ]]; then
    profile_line "${marker}" "${name}" "${suffix} ${C_DIM}(unreadable credential)${C_RESET}"
    return 0
  fi
  data="$(fetch_usage "${token}")" || data=""
  if [[ -z "${data}" ]]; then
    profile_line "${marker}" "${name}" "${suffix} ${C_DIM}(usage unavailable)${C_RESET}"
    return 0
  fi
  profile_line "${marker}" "${name}" "${suffix}"
  u5="$(pct_of "$(printf '%s' "${data}" | jq -r '.five_hour.utilization // 0 | floor' 2>/dev/null)")"
  u7="$(pct_of "$(printf '%s' "${data}" | jq -r '.seven_day.utilization // 0 | floor' 2>/dev/null)")"
  c5="$(pct_colour "${u5}")"
  c7="$(pct_colour "${u7}")"
  printf '    %b\n' "${C_DIM}5h:${C_RESET} ${c5}${u5}%${C_RESET}  ${C_DIM}7d:${C_RESET} ${c7}${u7}%${C_RESET}"
  limits="$(printf '%s' "${data}" |
    jq -r '.limits[]? | select(.is_active == true) | "\(.kind) \(.percent // 0 | floor)% (\(.severity))"' 2>/dev/null)" || limits=""
  if [[ -n "${limits}" ]]; then
    while IFS= read -r line; do
      if [[ -n "${line}" ]]; then printf '    %s\n' "${line}"; fi
    done <<<"${limits}"
  fi
}

cmd_usage() {
  mkdir -p "${PROFILES_DIR}"
  local current found=0 dir name type marker suffix
  current="$(current_profile 2>/dev/null)" || current=""
  header "Usage by Profile (best effort; Claude Code's /usage is authoritative)"
  for dir in "${PROFILES_DIR}"/*/; do
    [[ -d "${dir}" ]] || continue
    found=1
    name="${dir%/}"
    name="${name##*/}"
    type="$(profile_type "${name}")"
    marker=""
    suffix=""
    if [[ "${name}" == "${current}" ]]; then
      marker="${C_GREEN}${SYM_STAR}${C_RESET} "
      suffix=" ${C_GREEN}active${C_RESET}"
    fi
    if [[ "${type}" == "oauth" ]]; then
      usage_oauth "${dir}" "${name}" "${marker}" "${suffix}"
    else
      profile_line "${marker}" "${name}" "${suffix} ${C_DIM}(${type})${C_RESET}"
    fi
  done
  [[ ${found} -eq 0 ]] && dim "  No profiles saved."
  printf '\n'
  return 0
}

status_profile() {
  local name type
  header "Profile"
  name="$(current_profile 2>/dev/null)" || name=""
  if [[ -z "${name}" ]]; then
    dim "  No profile active"
    printf '\n'
    dim "  Get started:"
    printf '    %b\n' "${C_CYAN}cwtch profile setup <name>${C_RESET}"
    return 0
  fi
  type="$(profile_type "${name}")"
  printf '%b%s%b\n' "  ${C_GREEN}${SYM_STAR}${C_RESET} ${C_BOLD}" "${name}" "${C_RESET} ${C_DIM}(${type})${C_RESET}"
  case "${type}" in
    token | api-key) printf '    Apply to this shell: %b\n' "${C_CYAN}eval \"\$(cwtch profile env)\"${C_RESET}" ;;
    oauth) dim "    Claude Code uses the Keychain login" ;;
    'mixed!') dim "    More than one credential saved; save the profile again to fix it" ;;
    *) dim "    No credential saved" ;;
  esac
}

status_sources() {
  header "Sources"
  if ! config_exists; then
    dim "  Not configured"
    printf '  Run %b to get started\n' "${C_CYAN}cwtch sync init${C_RESET}"
    return 0
  fi
  local idx repo as path commit
  for idx in $(config_source_indices); do
    repo="$(config_source_get "${idx}" repo)" || repo=""
    as="$(config_source_get "${idx}" as)" || as=""
    path="$(repo_local_path "${repo}")" || path=""
    if [[ -n "${path}" ]] && [[ -d "${path}/.git" ]]; then
      commit="$(git -C "${path}" log -1 --format='%h' 2>/dev/null)" || commit="?"
      printf '  %b %s %b %s %b\n' "${C_GREEN}${SYM_CHECK}${C_RESET}" "${repo}" \
        "${C_CYAN}${SYM_ARROW}${C_RESET}" "${as:-(root)}" "${C_DIM}[${commit:-?}]${C_RESET}"
    else
      printf '  %b %s %b %s %b\n' "${C_YELLOW}${SYM_DOT}${C_RESET}" "${repo}" \
        "${C_CYAN}${SYM_ARROW}${C_RESET}" "${as:-(root)}" "${C_YELLOW}not synced${C_RESET}"
    fi
  done
  printf '\n'
  dim "  Config: ${CWTCHFILE}"
}

cmd_status() {
  printf '%b\n' "${C_BOLD}cwtch${C_RESET} ${C_DIM}v$(get_version)${C_RESET}"
  status_profile
  status_sources
  printf '\n'
  return 0
}

main() {
  [[ $# -lt 1 ]] && {
    usage_help
    exit 0
  }
  local cmd="$1"
  shift
  case "${cmd}" in
    status) cmd_status ;;
    usage) cmd_usage ;;
    refresh) cmd_refresh "$@" ;;
    sync) cmd_sync "$@" ;;
    profile) cmd_profile "$@" ;;
    edit) "${EDITOR:-vi}" "${CWTCHFILE}" ;;
    version) cmd_version ;;
    --version | -v) cmd_version_short ;;
    -h | --help) usage_help ;;
    *)
      err "Unknown: ${cmd}"
      usage_help
      exit 1
      ;;
  esac
}

main "$@"
